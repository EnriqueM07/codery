---
import "../styles/tailwind.css";

const {
  title = "Codery.mx | Desarrollo de software a la medida",
  description = "Desarrollo de software a la medida: aplicaciones web, móviles y de escritorio para empresas en México.",
} = Astro.props;
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#ffffff" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Open Graph básico -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Codery.mx" />

    <!-- Fuente Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5TNWW6D6NZ"></script>
    <script is:raw>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());
      gtag("config", "G-5TNWW6D6NZ");
    </script>

    <style>
      :root {
        --color-primary: #4f46e5;
        --color-secondary: #0891b2;
        --color-text: #0f172a;
        --color-muted: #475569;
        --color-bg: #f8fafc;
      }

      body {
        font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        background: #f8fafc;
        color: #0f172a;
        line-height: 1.6;
      }

      section {
        scroll-margin-top: 90px;
      }

      .btn-primary {
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          background 0.2s ease;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 30px rgba(79, 70, 229, 0.25);
      }

      .card-hover {
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          border-color 0.2s ease;
      }

      .card-hover:hover {
        transform: translateY(-4px);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
      }
    </style>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <slot />

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest" is:inline></script>
    <script is:inline>
      window.addEventListener("DOMContentLoaded", () => {
        if (window.lucide) {
          window.lucide.createIcons();
        }
      });
    </script>

    <!-- Scroll suave a secciones -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const links = document.querySelectorAll("a[href^='#']");

        links.forEach((link) => {
          link.addEventListener("click", (e) => {
            const targetId = link.getAttribute("href");

            if (!targetId || targetId === "#") return;

            const target = document.querySelector(targetId);

            if (target) {
              e.preventDefault();

              window.scrollTo({
                top: target.offsetTop - 72,
                behavior: "smooth",
              });
            }
          });
        });
      });
    </script>
  </body>
</html>